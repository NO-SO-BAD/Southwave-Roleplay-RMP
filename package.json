{
  "name": "southwave-roleplay-rmp",
  "version": "1.0.0",
  "description": "Southwave Roleplay RAGE:MP Gamemode",
  "main": "index.js",
  "scripts": {
    "build:server": "cd src/server && tsc",
    "watch:server": "cd src/server && tsc -w",
    "build:client": "webpack --config config/webpack.client.js",
    "watch:client": "webpack --watch --config config/webpack.client.js",
    "watch:both": "concurrently \"npm run watch:server\" \"npm run watch:client\"",
    "build:cef": "cd cef && vite build",
    "dev:cef": "cd cef && vite",
    "build:all": "npm run build:server && npm run build:client && npm run build:cef",
    "format:server": "prettier --config .prettierrc \"./src/server/**/*.ts\" --write",
    "format:client": "prettier --config .prettierrc \"./src/client/**/*.ts\" --write"
  },
  "keywords": [
    "RAGEMP",
    "GTA5",
    "Roleplay",
    "TypeScript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@ragempcommunity/types-client": "^2.1.9",
    "@ragempcommunity/types-server": "^2.1.9",
    "@types/node": "^20.12.11",
    "@types/uuid": "^9.0.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "concurrently": "^9.1.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "ts-loader": "^9.5.4",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vue-tsc": "^3.1.8",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^5.8.0",
    "webpack-node-externals": "^3.0.0",
    "webpack-obfuscator": "^3.5.1"
  },
  "dependencies": {
    "@vue/tsconfig": "^0.8.1",
    "bufferutil": "^4.0.7",
    "colorette": "^2.0.19",
    "discord-webhook-node": "^1.1.8",
    "dotenv": "^17.2.3",
    "keycode": "^2.2.1",
    "lodash": "^4.17.21",
    "module-alias": "^2.2.3",
    "node-cron": "^3.0.2",
    "pg": "^8.11.1",
    "pinia": "^3.0.4",
    "reflect-metadata": "^0.1.14",
    "typeorm": "^0.3.14",
    "uuid": "^8.3.2",
    "vue": "^3.5.25"
  },
"_moduleAliases": {
  "@api": "packages/server/api",
  "@assets": "packages/server/assets",
  "@classes": "packages/server/classes",
  "@events": "packages/server/serverevents",
  "@modules": "packages/server/modules",
  "@entities": "packages/server/database/entity",
  "@commands": "packages/server/commands",
  "@prototype": "packages/server/prototype",
  "@shared": "packages/shared",
  "@map": "packages/server/map"
}
}
