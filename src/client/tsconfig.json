{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "lib": ["es2015", "dom"],

    "baseUrl": "./src",
    "paths": {
      "@api": ["api/index.ts"],
      "@assets/*": ["assets/*"],
      "@classes/*": ["classes/*"],
      "@events/*": ["clientevents/*"],
      "@proc/*": ["clientprocs/*"],
      "@modules/*": ["modules/*"],
      "@handlers/*": ["handlers/*"],
      "@json/*": ["json/*"],
      "@prototype/*": ["prototype/*"],
      "@shared": ["../../shared/index.ts"],
      "@shared/*": ["../../shared/*"]
    },

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "noEmit": true,
    "noEmitOnError": false,
    "removeComments": true,
    "isolatedModules": false,
    "verbatimModuleSyntax": false
  },
  "files": [
    "../../node_modules/@ragempcommunity/types-client/index.d.ts"
  ],
  "include": [
    "src/**/*",
    "../shared/**/*"
  ]
}
